$ErrorActionPreference = 'Stop'

$DomainName = '<%= $domain_name %>'
$DomainNetbiosName = '<%= $domain_netbios_name %>'
$SafeModePassword = '<%= $safe_mode_password %>'

Write-Output "Domain name: $DomainName"
Write-Output "NetBIOS name: $DomainNetbiosName"
Write-Output "PowerShell version: $($PSVersionTable.PSVersion)"

# Check whether this machine is already a domain controller.

$computerSystem = Get-CimInstance Win32_ComputerSystem

if ($computerSystem.DomainRole -in 4, 5) {
    Write-Output "Machine is already a domain controller."
    exit 0
}

Write-Output "Machine is not yet a domain controller. Starting promotion."

$SecurePassword = ConvertTo-SecureString `
    $SafeModePassword `
    -AsPlainText `
    -Force

Install-ADDSForest `
    -DomainName $DomainName `
    -DomainNetbiosName $DomainNetbiosName `
    -SafeModeAdministratorPassword $SecurePassword `
    -InstallDns `
    -Force
