<%- | String $eg_email,
      String $eg_password,
      String $discord_webhook
| -%>
services:
  # ---------------------------------------------------------------
  # Free Games Claimer Remaster
  # ---------------------------------------------------------------
  app:
    # To run the experimental development build, set FGC_TAG=dev in your .env file!
    image: ghcr.io/p-adamiec/free-games-claimer-remaster:latest
    container_name: fgc-remaster
    restart: unless-stopped
    tty: true
    stdin_open: true
    ports:
      - "${NOVNC_PORT:-7080}:7080"
    volumes:
      - fgc_data:/fgc/data
    environment:
      - SHOW=1
      - WIDTH=1280
      - HEIGHT=720
      - NOVNC_PORT=7080
      - EG_EMAIL=<%= $eg_email %>
      - EG_PASSWORD=<%= $eg_password %>
      - DISCORD_WEBHOOK=<%= $discord_webhook %>
      - STORES=steam,epic
    healthcheck:
      test: pgrep python3 && curl --fail http://localhost:7080 || exit 1
      interval: 10s
      timeout: 5s
volumes:
  fgc_data:
